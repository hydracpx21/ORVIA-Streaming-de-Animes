# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# BLITZ_API_URL: URL da instância Blitz Anime API (padrão local embutido em http://127.0.0.1:3001 ou instância externa).
BLITZ_API_URL="http://127.0.0.1:3001"

# BLITZ_AUTH_TOKEN: Não exigido pela blitz-anime-api oficial (CORS aberto / sem autenticação por padrão).
BLITZ_AUTH_TOKEN=""

# BLITZ_DEFAULT_PROVIDER: Provedor padrão da blitz-anime-api (animeparadise, allmanga, anikoto, megaplay, gogoanime, goyabu).
BLITZ_DEFAULT_PROVIDER="animeparadise"

# AKARI_BACKEND_URL: Opcional — usado apenas no Cloudflare Pages (Settings > Environment variables) para encaminhar /api/* ao servidor Node/Tunnel.
# AKARI_BACKEND_URL="https://api.seudominio.com"

# ORVIA_PUBLISH_TOKEN: Opcional — chave privada do servidor para publicar atualizações oficiais remotamente via POST /api/internal/publish.
# Quando não definida, apenas requisições locais (127.0.0.1) ou builds diretos publicam atualizações.
# ORVIA_PUBLISH_TOKEN=""
